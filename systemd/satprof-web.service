[Unit]
Description=SatProf web interface
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=satprof
Group=satprof
WorkingDirectory=/opt/satprof
EnvironmentFile=-/etc/satprof/satprof.env
ExecStart=/opt/satprof/.venv/bin/satprof-web --config ${SATPROF_CONFIG}
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/satprof/workspace

[Install]
WantedBy=multi-user.target
