[Unit]
Description=SatProf background worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=satprof
Group=satprof
WorkingDirectory=/opt/satprof
EnvironmentFile=-/etc/satprof/satprof.env
ExecStart=/opt/satprof/.venv/bin/satprof-worker --config ${SATPROF_CONFIG}
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/satprof/workspace /opt/SatDump

[Install]
WantedBy=multi-user.target
