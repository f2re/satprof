[Unit]
Description=SatProf background worker and SatDump orchestrator
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=satprof
Group=satprof
WorkingDirectory=/opt/satprof
EnvironmentFile=-/etc/satprof/satprof.env
ExecStart=/opt/satprof/.venv/bin/satprof-worker --config ${SATPROF_CONFIG}
Restart=always
RestartSec=5
TimeoutStartSec=60
TimeoutStopSec=120
KillSignal=SIGINT
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=false
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=6

[Install]
WantedBy=multi-user.target
